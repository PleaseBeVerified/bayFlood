{
  "name": "bay-area-flood-risk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:dnn-data": "node --test tests/dnn-scenarios.test.mjs",
    "test:dnn-model": "node --experimental-strip-types --test tests/dnn-model.test.mjs",
    "test": "npm run test:dnn-data && npm run test:dnn-model && node --experimental-strip-types --test tests/future-scenarios.test.mjs tests/fema-event-benchmark.test.mjs tests/fema-live-lookup.test.mjs tests/dnn-three-class.test.mjs tests/boosted-model.test.mjs",
    "dnn:data:template": "node scripts/build-dnn-data.mjs template",
    "dnn:data:sample-imperviousness": "node scripts/sample-nlcd-imperviousness.mjs",
    "dnn:data": "node scripts/build-dnn-data.mjs build",
    "dnn:data:research": "node scripts/build-dnn-data.mjs build --include-research",
    "dnn:train": ".venv-model/bin/python scripts/train-dnn-flood-model.py",
    "model:train:boosted": ".venv-model/bin/python scripts/train-boosted-flood-model.py",
    "dnn:train:three-class": ".venv-model/bin/python scripts/train-three-class-dnn.py",
    "dnn:all": "npm run dnn:data:sample-imperviousness && npm run dnn:data && npm run dnn:train && npm run model:train:boosted && npm run test"
  },
  "dependencies": {
    "geotiff": "^3.0.5",
    "maplibre-gl": "^5.24.0",
    "next": "^16.3.0",
    "proj4": "^2.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
