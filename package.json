{
  "name": "bay-area-flood-risk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:dnn-data": "node --test tests/dnn-scenarios.test.mjs",
    "test:dnn-model": "node --experimental-strip-types --test tests/dnn-model.test.mjs",
    "test": "npm run test:dnn-data && npm run test:dnn-model && node --experimental-strip-types --test tests/future-scenarios.test.mjs tests/fema-event-benchmark.test.mjs tests/fema-live-lookup.test.mjs tests/dnn-three-class.test.mjs tests/boosted-model.test.mjs tests/terrain-dnn-model.test.mjs tests/terrain-three-class-model.test.mjs",
    "dnn:data:template": "node scripts/build-dnn-data.mjs template",
    "dnn:data:sample-imperviousness": "node scripts/sample-nlcd-imperviousness.mjs",
    "dnn:data": "node scripts/build-dnn-data.mjs build",
    "dnn:data:research": "node scripts/build-dnn-data.mjs build --include-research",
    "dnn:train": ".venv-model/bin/python scripts/train-dnn-flood-model.py",
    "model:train:boosted": ".venv-model/bin/python scripts/train-boosted-flood-model.py",
    "model:experiment:high-elevation": ".venv-model/bin/python scripts/train-high-elevation-fema-baseline.py",
    "model:experiment:terrain": ".venv-model/bin/python scripts/train-terrain-fema-baselines.py",
    "model:experiment:terrain-dnn": ".venv-model/bin/python scripts/train-terrain-dnn.py",
    "model:cnn:patches": "python3 scripts/build-terrain-cnn-patches.py",
    "model:cnn:three-class-patches": "python3 scripts/build-terrain-cnn-patches.py --three-class",
    "model:cnn:rasters": "python3 scripts/build-terrain-cnn-patches.py --rasters-only",
    "model:experiment:terrain-cnn": ".venv-model/bin/python scripts/train-terrain-cnn.py",
    "model:experiment:terrain-cnn-extended": ".venv-model/bin/python scripts/train-terrain-cnn.py --extended",
    "model:experiment:terrain-cnn-point-only": ".venv-model/bin/python scripts/terrain-cnn-point-only-ablation.py",
    "model:experiment:terrain-three-class-cnn": ".venv-model/bin/python scripts/train-terrain-three-class-cnn.py",
    "model:cnn:three-class-external-patches": "python3 scripts/build-santa-cruz-north-cnn-patches.py --three-class",
    "model:experiment:terrain-three-class-cnn-external": ".venv-model/bin/python scripts/evaluate-terrain-three-class-cnn-external.py",
    "dnn:train:three-class": ".venv-model/bin/python scripts/train-three-class-dnn.py",
    "dnn:train:terrain-three-class": ".venv-model/bin/python scripts/train-terrain-three-class-dnn.py",
    "model:experiment:terrain-three-class": ".venv-model/bin/python scripts/train-terrain-three-class-boosted.py",
    "dnn:all": "npm run dnn:data:sample-imperviousness && npm run dnn:data && npm run dnn:train && npm run model:train:boosted && npm run model:experiment:terrain && npm run model:experiment:terrain-dnn && npm run test"
  },
  "dependencies": {
    "geotiff": "^3.0.5",
    "maplibre-gl": "^5.24.0",
    "next": "^16.3.0",
    "proj4": "^2.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
