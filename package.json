{
  "name": "bay-area-flood-risk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "terrain:features": ".venv-whitebox/bin/python scripts/build-terrain-features.py",
    "terrain:runtime": ".venv-whitebox/bin/python scripts/build-runtime-terrain.py",
    "terrain:serve": "node scripts/serve-runtime-terrain.mjs",
    "fema:sync": "node scripts/sync-fema-nfhl.mjs",
    "fema:verify": "node --experimental-strip-types scripts/verify-fema-nfhl.mjs",
    "test:fema": "node --experimental-strip-types --test tests/fema.test.mjs",
    "test:probability": "node --experimental-strip-types --test tests/flood-probability.test.mjs",
    "test:physical-estimate": "node --experimental-strip-types --test tests/physical-flood-estimate.test.mjs",
    "test:terrain": "node --experimental-strip-types --test tests/terrain.test.mjs",
    "test:model": "node --experimental-strip-types --test tests/flood-model.test.mjs",
    "test:observations": "node --test tests/property-observations.test.mjs",
    "test:openfema": "node --test tests/openfema-candidates.test.mjs",
    "test:census-area": "node --test tests/census-area.test.mjs",
    "test:area-signal": "node --experimental-strip-types --test tests/fema-area-signal.test.mjs",
    "test": "npm run test:probability && npm run test:physical-estimate && npm run test:terrain && npm run test:model && npm run test:fema && npm run test:observations && npm run test:openfema && npm run test:census-area && npm run test:area-signal",
    "training:table": "node scripts/build-training-table.mjs",
    "training:comparisons": "node scripts/generate-comparison-labels.mjs",
    "training:candidates": "node scripts/generate-property-candidates.mjs",
    "training:openfema": "node scripts/generate-openfema-candidates.mjs",
    "training:area-cache": "node scripts/download-openfema-parquet.mjs",
    "training:area-rates": "node scripts/build-fema-area-rates.mjs",
    "training:area-join": "node scripts/join-property-area-rates.mjs",
    "training:area-pipeline": "npm run training:area-cache && npm run training:area-rates && npm run training:area-join && npm run hazard:readiness",
    "training:model": "node scripts/train-flood-model.mjs",
    "calibration:physical-table": "node --experimental-strip-types scripts/build-physical-hazard-calibration.mjs",
    "calibration:physical-model": ".venv-model/bin/python scripts/train-boosted-hazard-model.py",
    "calibration:three-class-benchmark": ".venv-model/bin/python scripts/train-three-class-hazard-benchmark.py",
    "calibration:merge-point-two": ".venv-model/bin/python scripts/merge-physical-hazard-calibration.py",
    "calibration:three-class-expanded": ".venv-model/bin/python scripts/train-three-class-hazard-benchmark.py --input=data/physical-hazard-calibration-expanded.csv --tag=expanded-point-two",
    "calibration:three-class-search": ".venv-model/bin/python scripts/search-three-class-data-weights.py",
    "calibration:physical": "npm run calibration:physical-table && npm run calibration:physical-model",
    "testing:firststreet": "node scripts/test-firststreet-model.mjs",
    "hazard:validate": "node scripts/validate-property-observations.mjs",
    "hazard:features": "node --experimental-strip-types scripts/build-property-feature-table.mjs",
    "hazard:table": "node scripts/build-hazard-table.mjs",
    "hazard:readiness": "node scripts/report-hazard-readiness.mjs",
    "hazard:prepare": "npm run hazard:validate && npm run hazard:features && npm run hazard:table && npm run hazard:readiness"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.0",
    "geotiff": "^3.0.5",
    "maplibre-gl": "^5.24.0",
    "next": "^16.3.0",
    "pmtiles": "^4.4.1",
    "proj4": "^2.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.5.5-r.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
